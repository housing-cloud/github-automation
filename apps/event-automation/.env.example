# event-automation — example environment
#
# Copy to `.env` and fill in. See REQUIREMENTS.md for where each value comes
# from and the GitHub App permissions the check runs + PR comments need.
#
#   cp apps/event-automation/.env.example apps/event-automation/.env
#
# Never commit the filled-in `.env` — `.gitignore` already excludes it.

# ─────────────────────────────────────────────────────────────────────────────
# GitHub App  (REQUIRED)
# Permissions: Checks RW, Pull requests RW, Issues RW, Contents R, Metadata R.
# Webhook: subscribe to "Pull requests", point at https://<host>/webhooks/github
# ─────────────────────────────────────────────────────────────────────────────

# GitHub App settings → "App ID"
GITHUB_APP_ID=123456

# GitHub App settings → "Generate a private key" (PEM).
# Literal \n escapes are decoded at load, so the key can live on one line.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"

# The numeric id in the installation URL:
# github.com/organizations/<org>/settings/installations/<INSTALLATION_ID>
GITHUB_APP_INSTALLATION_ID=87654321

# The org the repos live under.
GITHUB_ORG=housing-cloud

# Comma-separated repo names the service may act on. Anything else is ignored.
GITHUB_ALLOWED_REPOS=web,api

# The secret configured on the App's webhook (verified as x-hub-signature-256).
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=replace-me-with-a-random-32-byte-hex

# ─────────────────────────────────────────────────────────────────────────────
# preview-stacks / pstack  (REQUIRED)
# Drives the `pstack/stack`, `pstack/db-seed` and `pstack/web` check runs plus
# the tracked "Preview stack" PR comment.
# ─────────────────────────────────────────────────────────────────────────────

# The signing secret pstack shows ONCE when the notifier is created
# (Notifiers → New → type "webhook", or POST /api/notifiers). It cannot be shown
# again. Point the notifier at:
#   https://<host>/webhooks/preview-stacks
# and subscribe it to at least:
#   job.started, job.succeeded, job.failed, job.leaked, job.cancelled,
#   stack.ready, stack.failed, stack.timedout,
#   container.ready, container.start-failed, container.stopped
# NOTE: a `slack`/`discord` notifier sends unsigned prose and will NOT work.
PSTACK_WEBHOOK_SECRET=whsec_replace-me

# Bearer secret for the operator-only pstack checks cleanup webhook:
#   POST https://<host>/webhooks/pstack/checks/clear
#   Authorization: Bearer <this value>
#   {"stack":"pr-16828"} clears one stack; {"all":true} clears every open PR.
# Specific cleanup requires the canonical pr-<number> stack name.
# GitHub cannot delete check suites, so "clear" completes pstack/* runs as skipped.
#   openssl rand -hex 32
PSTACK_CHECKS_WEBHOOK_SECRET=replace-me-with-a-random-32-byte-hex

# The repo whose PRs these stacks belong to. pstack payloads name a stack
# (`pr-16828`) and never a repository, so this is the only way an event gets
# one. Must also appear in GITHUB_ALLOWED_REPOS.
PSTACK_REPO=web

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Compose services that each get their own check run. Defaults to `db-seed,web`.
# PSTACK_SERVICES=db-seed,web

# pstack dashboard URL, linked from the checks and the PR comment.
# PSTACK_BASE_URL=https://pstack.housing.cloud

# pstack CONTROL-PLANE API (`https://api.<preview-domain>`). Optional, and what
# switches on the parts of this service that ASK pstack things rather than
# waiting to be told:
#   - the PR comment links the hostnames Traefik actually serves, read from the
#     stack's live routing table instead of a reconstructed pattern;
#   - the `@cloudybot recheck|redeploy|restart` commands (and their
#     `cloudy-*` labels) are registered.
# Without it the service is purely push-driven and the commands are not offered.
# PSTACK_API_URL=https://api.preview.housing.cloud

# Token for the API above. GETs are open, so the live URLs work without one;
# `redeploy` and `restart` are POSTs and DO need it. Use the host's
# PSTACK_TOKEN or a personal `pstack_pat_…`.
# Setting this without PSTACK_API_URL is rejected at startup.
# PSTACK_API_TOKEN=pstack_pat_replace-me

# Preview domain, used to build the per-service URL `<service>-<stack>.<domain>`
# shown in the comment when PSTACK_API_URL is not set (with it, the real routing
# table is used instead). This must match the domain in the pstack spec.
# PSTACK_PREVIEW_DOMAIN=preview.housing.cloud

# Replay window for pstack deliveries. Defaults to 300000 (5 minutes).
# PSTACK_TOLERANCE_MS=300000

# How long a @cloudybot command waits for the stack to finish converging before
# it stops watching. Defaults to 600000 (10 minutes). pstack's own readiness
# events still settle the checks afterwards.
# PSTACK_COMMAND_TIMEOUT_MS=600000

# Comment on every newly opened PR explaining the three preview labels:
#   preview          — run a preview stack for this PR (transitional; previews
#                      become the default later)
#   no-preview       — do not run one while the label is present
#   preserve-preview — keep the stack alive after the PR is closed
# The comment is posted once per PR and never edited. Off by default: it writes
# to EVERY opened PR in GITHUB_ALLOWED_REPOS, including ones that never get a
# preview. Needs the App subscribed to Pull requests (it already is).
# PR_OPENED_COMMENT=true

# Rows retained by the in-memory webhook log.
# EVENT_LOG_LIMIT=500

# Shared key for the bulk PR-approval webhook, POST /webhooks/approvals.
# UNSET DISABLES THE ROUTE — there is no safe default for something that
# approves pull requests. Accepted as `X-Api-Key: <key>`,
# `Authorization: Bearer <key>`, or `?key=`/`?token=` in the URL.
# Must be at least 32 characters; generate with `openssl rand -hex 32`.
# The GitHub App also needs Pull requests: Read & write to submit reviews.
# APPROVALS_WEBHOOK_SECRET=replace-me-with-a-random-32-byte-hex

# Bearer token gating /events and /dashboard. SET THIS if the service is
# internet-facing — those pages are public when it is unset.
# Accepted as `Authorization: Bearer <token>` or `?token=<token>`.
# EVENT_LOG_TOKEN=replace-me-with-a-random-32-byte-hex

# SQLite file retaining dashboard flow-run history across restarts.
# The container defaults this to /data/flow-runs.sqlite; mount a persistent
# platform volume at /data or set this to another mounted path.
# FLOW_RUN_DB_PATH=./data/flow-runs.sqlite

# Maximum flow runs retained in SQLite. Defaults to 200.
# FLOW_RUN_LIMIT=200

# Listen port.
# PORT=8080
