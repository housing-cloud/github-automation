# event-automation — example environment
#
# Copy to `.env` and fill in. See REQUIREMENTS.md for where each value comes
# from and the GitHub App permissions the check runs + PR comments need.
#
#   cp apps/event-automation/.env.example apps/event-automation/.env
#
# Never commit the filled-in `.env` — `.gitignore` already excludes it.

# ─────────────────────────────────────────────────────────────────────────────
# GitHub App  (REQUIRED)
# Permissions: Checks RW, Pull requests RW, Issues RW, Contents R, Metadata R.
# Webhook: subscribe to "Pull requests", point at https://<host>/webhooks/github
# ─────────────────────────────────────────────────────────────────────────────

# GitHub App settings → "App ID"
GITHUB_APP_ID=123456

# GitHub App settings → "Generate a private key" (PEM).
# Literal \n escapes are decoded at load, so the key can live on one line.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"

# The numeric id in the installation URL:
# github.com/organizations/<org>/settings/installations/<INSTALLATION_ID>
GITHUB_APP_INSTALLATION_ID=87654321

# The org the repos live under.
GITHUB_ORG=housing-cloud

# Comma-separated repo names the service may act on. Anything else is ignored.
GITHUB_ALLOWED_REPOS=web,api

# The secret configured on the App's webhook (verified as x-hub-signature-256).
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=replace-me-with-a-random-32-byte-hex

# ─────────────────────────────────────────────────────────────────────────────
# Dokploy  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# Your instance root. No trailing slash needed (one is trimmed anyway).
DOKPLOY_BASE_URL=https://dokploy.housing.cloud

# Dokploy → /settings/profile → API/CLI → "Generate token". Sent as x-api-key.
DOKPLOY_API_KEY=dokploy-api-token

# A secret YOU invent — Dokploy does not generate one, because its webhooks are
# unsigned. Add the matching header in Dokploy → Notifications → Webhook:
#   URL:    https://<host>/webhooks/dokploy
#   Header: x-webhook-token: <this value>
#   openssl rand -hex 32
DOKPLOY_WEBHOOK_TOKEN=replace-me-with-a-random-32-byte-hex

# Which Dokploy application holds the preview deployments for each repo.
# Format: repo:applicationId[:displayName]  (comma-separated)
#   - repo          must also appear in GITHUB_ALLOWED_REPOS (startup fails otherwise)
#   - applicationId from the dashboard URL: …/services/application/<applicationId>
#   - displayName   optional; shown in the check title `dokploy/<name> (preview)`.
#                   Defaults to the repo name.
DOKPLOY_REPO_APPLICATION_MAP=web:kZ8sq2Lm-abc:web-app,api:Tq91xNb-def

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Attribute Dokploy-sourced webhook events back to a repo. Only affects the
# event log and the Slack alert — the PR check does not need it.
# Format: project/application:repo  (or bare application:repo), comma-separated.
# DOKPLOY_APPLICATION_REPO_MAP=hou/web:web,hou/api:api

# How often the tracker re-reads a preview's status. Must be >= 1000.
# PREVIEW_POLL_INTERVAL_MS=30000

# How long before an unreported preview fails the check as `timed_out`.
# PREVIEW_TIMEOUT_MS=1800000

# When set, Dokploy build failures also post to Slack.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# Rows retained by the in-memory webhook log.
# EVENT_LOG_LIMIT=500

# Bearer token gating /events and /dashboard. SET THIS if the service is
# internet-facing — those pages are public when it is unset.
# Accepted as `Authorization: Bearer <token>` or `?token=<token>`.
# EVENT_LOG_TOKEN=replace-me-with-a-random-32-byte-hex

# Listen port.
# PORT=8080
